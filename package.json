    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "sortablejs-vue3": "^1.3.0",
    "vue": "^3.5.25",
    "vuetify": "^4.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.1.6"
  }
