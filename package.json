{
  "name": "lutedrop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --config vite.remote.config.ts",
    "dev:all": "concurrently \"cargo tauri dev\" \"npm run dev:remote\"",
    "build": "vue-tsc --noEmit && vite build",
    "build:remote": "vue-tsc --noEmit && vite build --config vite.remote.config.ts",
    "lint": "eslint .",
    "check:generated": "node scripts/check-generated.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "vuetify": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tauri-apps/cli": "^2",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.12.0",
    "vite": "^7.2.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.1.6"
  }
}
