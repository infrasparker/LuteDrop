{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LuteDrop",
  "version": "0.2.0",
  "identifier": "com.lutedrop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:remote"
  },
  "app": {
    "windows": [
      {
        "title": "LuteDrop",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "resources": {
      "../dist-remote/*": "dist-remote/",
      "../dist-remote/assets/*": "dist-remote/assets/"
    }
  }
}
